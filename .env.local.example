# Copiá este archivo a .env.local y completá los valores.
# .env.local NO se sube al repo (está en .gitignore).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...

# Mercado Pago (opcional: solo para el cobro online)
# MP Developers → Tus integraciones → tu aplicación
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Webhooks → clave secreta
MP_WEBHOOK_SECRET=
# Clave para cifrar los tokens de los negocios: openssl rand -base64 32
MP_TOKEN_KEY=
# Modo prueba por defecto. Para cobrar dinero real: false
# MP_MODO_PRUEBA=true
